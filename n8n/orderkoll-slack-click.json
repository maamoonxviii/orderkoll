    {
      "id": "2410d4f2-209b-5d0a-8004-e7659dff9915",
      "name": "Tell Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -100],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
