    {
      "id": "fa82762a-4eb7-5d32-b079-ba6b96613e9e",
      "name": "Raw body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "// Slack signs \"v0:\" + timestamp + \":\" + the raw form body; \"Raw text\" turned the webhook's\n// raw body into text (works whatever binary-data mode n8n runs in).\nconst headers = $('From Slack').first().json.headers;\nreturn [{ json: {\n  raw: String($input.first().json.raw || ''),\n  ts: headers['x-slack-request-timestamp'],\n  sig: headers['x-slack-signature'],\n} }];"
      }
    },
    {
      "id": "b36d0318-a5a3-58bf-ac55-77a8ca21a465",
      "name": "Slack signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "=v0:{{ $json.ts }}:{{ $json.raw }}",
        "dataPropertyName": "expected",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "__CRED_ORDERKOLL_SLACK_SIGNING_SECRET__",
          "name": "Orderkoll Slack signing secret"
        }
      }
    },
    {
      "id": "917170b4-52cb-5134-9b38-8f43bcb730e0",
      "name": "Check the click",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "const it = $input.first().json;\nconst fresh = Math.abs(Date.now() / 1000 - Number(it.ts)) < 300;\nif (!fresh || !it.sig || 'v0=' + it.expected !== it.sig) return [{ json: { ok: false } }];\nconst m = it.raw.match(/(?:^|&)payload=([^&]*)/);\nif (!m) return [{ json: { ok: false } }];\nconst payload = JSON.parse(decodeURIComponent(m[1].replace(/\\+/g, ' ')));\nconst action = (payload.actions || [])[0];\nconst allowed = '__ODOO_BASE_URL__/orderkoll/approve/';\nif (!action || !String(action.value || '').startsWith(allowed)) return [{ json: { ok: false } }];\n// Only your workspace, and (if listed) only the named approvers, may decide.\nif (!payload.team || payload.team.id !== '__SLACK_TEAM_ID__') return [{ json: { ok: false } }];\nconst uid = (payload.user && payload.user.id) || '';\nconst approvers = '__SLACK_APPROVER_IDS__'.split(',').map((x) => x.trim()).filter(Boolean);\nif (approvers.length && !approvers.includes(uid)) {\n  return [{ json: { ok: false, url: payload.response_url,\n    notice: 'You are not on the approver list for purchase orders.' } }];\n}\nconst name = (payload.user && (payload.user.name || payload.user.username)) || 'Slack user';\nconst who = `${name} (${uid})`;\nconst body = JSON.stringify({\n  action: action.action_id === 'orderkoll_approve' ? 'approve' : 'reject',\n  user: who,\n  token: String(action.value).split('/').pop(),  // the signature covers which request this is\n});\nreturn [{ json: {\n  ok: true, url: action.value, body, who,\n  ts: String(Math.floor(Date.now() / 1000)),\n  response_url: payload.response_url,\n  original: payload.message || {},\n} }];"
      }
    },
    {
      "id": "0fec3a35-9001-572c-87c9-aed4648c8378",
      "name": "Signed by Slack?",
