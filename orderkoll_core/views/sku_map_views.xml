<odoo>
    <record id="view_sku_map_list" model="ir.ui.view">
        <field name="name">orderkoll.sku_map.list</field>
        <field name="model">orderkoll.sku_map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id" />
                <field name="customer_code" />
                <field name="product_id" />
                <field name="hit_count" readonly="1" />
                <field name="confirmed_by" readonly="1" />
                <field name="confirmed_on" readonly="1" />
            </list>
        </field>
    </record>

    <record id="action_sku_map" model="ir.actions.act_window">
        <field name="name">Customer code memory</field>
        <field name="res_model">orderkoll.sku_map</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
