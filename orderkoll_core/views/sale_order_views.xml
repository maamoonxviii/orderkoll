<odoo>
    <record id="view_order_form_orderkoll" model="ir.ui.view">
        <field name="name">sale.order.form.orderkoll</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field
          name="orderkoll_document_id"
          invisible="not orderkoll_document_id"
          groups="orderkoll_core.group_orderkoll_user"
        />
            </field>
        </field>
    </record>
</odoo>
