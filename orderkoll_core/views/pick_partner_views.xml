<odoo>
    <record id="view_pick_partner_form" model="ir.ui.view">
        <field name="name">orderkoll.pick_partner.form</field>
        <field name="model">orderkoll.pick_partner</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="document_id" invisible="1" />
                    <field name="sender_email" />
                    <field name="partner_id" />
                    <field name="remember_sender" />
                </group>
                <footer>
                    <button
            name="action_pick"
            type="object"
            string="Use this customer"
            class="btn-primary"
          />
                    <button
            string="Cancel"
            class="btn-secondary"
            special="cancel"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
