<odoo>
    <record id="module_category_orderkoll" model="ir.module.category">
        <field name="name">Orderkoll</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_orderkoll_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_orderkoll" />
        <field
      name="implied_ids"
      eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]"
    />
    </record>

    <record id="group_orderkoll_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_orderkoll" />
        <field name="implied_ids" eval="[(4, ref('group_orderkoll_user'))]" />
        <field
      name="users"
      eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
    />
    </record>

    <record id="rule_inbox_company" model="ir.rule">
        <field name="name">Orderkoll inbox: own companies</field>
        <field name="model_id" ref="model_orderkoll_inbox" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_document_company" model="ir.rule">
        <field name="name">Orderkoll document: own companies</field>
        <field name="model_id" ref="model_orderkoll_document" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_line_company" model="ir.rule">
        <field name="name">Orderkoll line: own companies</field>
        <field name="model_id" ref="model_orderkoll_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sku_map_company" model="ir.rule">
        <field name="name">Orderkoll customer code memory: own companies</field>
        <field name="model_id" ref="model_orderkoll_sku_map" />
        <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
